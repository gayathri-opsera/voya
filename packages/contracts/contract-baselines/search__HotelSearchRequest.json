{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "checkInDate": {
      "type": "string"
    },
    "checkOutDate": {
      "type": "string"
    },
    "currency": {
      "allOf": [
        {
          "type": "string"
        },
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      ]
    },
    "destination": {
      "maxLength": 200,
      "minLength": 2,
      "type": "string"
    },
    "guests": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "starRating": {
      "enum": [
        3,
        4,
        5
      ],
      "type": "number"
    }
  },
  "required": [
    "destination",
    "checkInDate",
    "checkOutDate",
    "guests",
    "currency"
  ],
  "type": "object"
}
