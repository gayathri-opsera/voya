{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "bookingType": {
      "enum": [
        "FLIGHT",
        "HOTEL",
        "CAR"
      ],
      "type": "string"
    },
    "contactEmail": {
      "format": "email",
      "type": "string"
    },
    "contactPhone": {
      "pattern": "^\\+?[0-9\\s\\-().]{7,20}$",
      "type": "string"
    },
    "currency": {
      "allOf": [
        {
          "type": "string"
        },
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      ]
    },
    "idempotencyKey": {
      "minLength": 1,
      "pattern": "^[0-9A-Za-z_-]{10,128}$",
      "type": "string"
    },
    "offerId": {
      "minLength": 1,
      "pattern": "^[0-9A-Za-z_-]{10,128}$",
      "type": "string"
    },
    "passengers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dateOfBirth": {
            "type": "string"
          },
          "firstName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "nationality": {
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          },
          "passportNumber": {
            "pattern": "^[A-Z0-9]{6,20}$",
            "type": "string"
          },
          "specialRequests": {
            "maxLength": 500,
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "dateOfBirth"
        ],
        "type": "object"
      },
      "maxItems": 9,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "offerId",
    "bookingType",
    "passengers",
    "contactEmail",
    "currency",
    "idempotencyKey"
  ],
  "type": "object"
}
