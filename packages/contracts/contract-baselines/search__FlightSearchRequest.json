{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "allOf": [
        {
          "type": "string"
        },
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      ]
    },
    "departureDate": {
      "type": "string"
    },
    "destination": {
      "allOf": [
        {
          "type": "string"
        },
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      ]
    },
    "origin": {
      "allOf": [
        {
          "type": "string"
        },
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      ]
    },
    "passengers": {
      "maximum": 9,
      "minimum": 1,
      "type": "integer"
    },
    "returnDate": {
      "type": "string"
    },
    "seatClass": {
      "enum": [
        "ECONOMY",
        "PREMIUM_ECONOMY",
        "BUSINESS",
        "FIRST"
      ],
      "type": "string"
    }
  },
  "required": [
    "origin",
    "destination",
    "departureDate",
    "passengers",
    "seatClass",
    "currency"
  ],
  "type": "object"
}
