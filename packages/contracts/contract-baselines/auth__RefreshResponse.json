{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "accessToken": {
      "minLength": 1,
      "type": "string"
    },
    "expiresIn": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "refreshToken": {
      "minLength": 1,
      "type": "string"
    },
    "tokenType": {
      "const": "Bearer",
      "type": "string"
    }
  },
  "required": [
    "accessToken",
    "refreshToken",
    "expiresIn",
    "tokenType"
  ],
  "type": "object"
}
