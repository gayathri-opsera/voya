{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "accessToken": {
      "minLength": 1,
      "type": "string"
    },
    "expiresIn": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "refreshToken": {
      "minLength": 1,
      "type": "string"
    },
    "role": {
      "enum": [
        "traveler",
        "support_agent",
        "system"
      ],
      "type": "string"
    },
    "tokenType": {
      "const": "Bearer",
      "type": "string"
    },
    "userId": {
      "minLength": 1,
      "pattern": "^[0-9A-Za-z_-]{10,128}$",
      "type": "string"
    }
  },
  "required": [
    "accessToken",
    "refreshToken",
    "expiresIn",
    "tokenType",
    "userId",
    "role"
  ],
  "type": "object"
}
