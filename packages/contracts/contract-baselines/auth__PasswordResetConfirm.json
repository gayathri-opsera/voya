{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "confirmPassword": {
      "minLength": 1,
      "type": "string"
    },
    "newPassword": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)",
      "type": "string"
    },
    "token": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "token",
    "newPassword",
    "confirmPassword"
  ],
  "type": "object"
}
