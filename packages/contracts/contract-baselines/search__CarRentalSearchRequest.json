{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "carClass": {
      "enum": [
        "ECONOMY",
        "COMPACT",
        "MIDSIZE",
        "PREMIUM",
        "SUV"
      ],
      "type": "string"
    },
    "currency": {
      "allOf": [
        {
          "type": "string"
        },
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      ]
    },
    "dropoffDate": {
      "type": "string"
    },
    "dropoffLocation": {
      "maxLength": 200,
      "minLength": 2,
      "type": "string"
    },
    "pickupDate": {
      "type": "string"
    },
    "pickupLocation": {
      "maxLength": 200,
      "minLength": 2,
      "type": "string"
    }
  },
  "required": [
    "pickupLocation",
    "dropoffLocation",
    "pickupDate",
    "dropoffDate",
    "carClass",
    "currency"
  ],
  "type": "object"
}
