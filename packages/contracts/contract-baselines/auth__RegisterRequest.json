{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "email": {
      "format": "email",
      "type": "string"
    },
    "firstName": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "lastName": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "password": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)",
      "type": "string"
    }
  },
  "required": [
    "email",
    "password",
    "firstName",
    "lastName"
  ],
  "type": "object"
}
