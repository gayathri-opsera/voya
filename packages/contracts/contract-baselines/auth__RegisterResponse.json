{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "email": {
      "format": "email",
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "role": {
      "enum": [
        "traveler",
        "support_agent",
        "system"
      ],
      "type": "string"
    },
    "userId": {
      "minLength": 1,
      "pattern": "^[0-9A-Za-z_-]{10,128}$",
      "type": "string"
    },
    "verificationEmailSent": {
      "type": "boolean"
    }
  },
  "required": [
    "userId",
    "email",
    "firstName",
    "lastName",
    "role",
    "verificationEmailSent",
    "createdAt"
  ],
  "type": "object"
}
