{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "code": {
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "enum": [
        "google",
        "apple"
      ],
      "type": "string"
    },
    "redirectUri": {
      "format": "uri",
      "type": "string"
    },
    "state": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "code",
    "state",
    "provider",
    "redirectUri"
  ],
  "type": "object"
}
