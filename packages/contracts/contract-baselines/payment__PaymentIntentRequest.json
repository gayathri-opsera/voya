{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
    },
    "bookingId": {
      "minLength": 1,
      "pattern": "^[0-9A-Za-z_-]{10,128}$",
      "type": "string"
    },
    "currency": {
      "allOf": [
        {
          "type": "string"
        },
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      ]
    },
    "idempotencyKey": {
      "minLength": 1,
      "pattern": "^[0-9A-Za-z_-]{10,128}$",
      "type": "string"
    },
    "paymentMethodType": {
      "default": "CARD",
      "enum": [
        "CARD",
        "BANK_TRANSFER",
        "WALLET"
      ],
      "type": "string"
    },
    "returnUrl": {
      "format": "uri",
      "type": "string"
    }
  },
  "required": [
    "bookingId",
    "amount",
    "currency",
    "idempotencyKey"
  ],
  "type": "object"
}
