# Strict peer dependency enforcement
strict-peer-dependencies=false
auto-install-peers=false

# Disable phantom dependencies
# shamefully-hoist is intentionally omitted (defaults to false)
node-linker=hoisted

# Frozen lockfile in CI
# (Controlled by --frozen-lockfile flag in CI pipelines)

# Allow builds for whitelisted packages
ignore-scripts=false

# Consistent registry
registry=https://registry.npmjs.org/
